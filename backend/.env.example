# Copy to .env and fill in. NEVER put real values in this file — it is tracked
# by git, unlike .env.

NODE_ENV=development
PORT=3000

# Local docker stack. The replicaSet=rs0 is mandatory: booking writes use
# transactions and a standalone mongod rejects every one of them.
# For MongoDB Atlas use a mongodb+srv:// URI instead and DROP the replicaSet
# parameter — +srv is already a replica set.
MONGO_URI=mongodb://localhost:27017/scalivo?replicaSet=rs0
POSTGRES_URL=postgres://scalivo:scalivo@localhost:5432/scalivo
REDIS_URL=redis://localhost:6379
# Hosted Redis (Upstash etc.) needs rediss:// — the double s turns on TLS.

# Point at the spike stack in ../open-wa for local work.
OPENWA_BASE_URL=http://localhost:2785
# Header-only: X-API-Key: owa_k1_<64hex>. Use a key scoped with allowedSessions,
# not the seeded admin key.
OPENWA_API_KEY=owa_k1_replace_me
# Must match the `secret` used when registering the webhook with OpenWA.
# Onboarding now registers webhooks itself using this value, so it is no longer
# something to keep in sync by hand.
OPENWA_WEBHOOK_SECRET=replace_with_a_long_random_string

# Where the GATEWAY can reach US. Onboarding registers <PUBLIC_URL>/webhooks/whatsapp
# as each new session's webhook, so a wrong value produces a session that links
# fine and then never delivers a single message.
#
# Two things bite here. The gateway runs in Docker, so localhost is ITS own
# container — use host.docker.internal (or the compose service name) rather than
# 127.0.0.1. And WEBHOOK_SSRF_PROTECT=true means the host has to be on the
# gateway's allowlist, or registration is refused outright.
PUBLIC_URL=http://host.docker.internal:3000

# openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_characters_of_random

# Browser origins allowed to call /public (the marketplace booking flow).
# Comma-separated. Loopback is already allowed when NODE_ENV=development.
WEB_ORIGINS=https://scalivo.app

MESSAGING_PROVIDER=openwa

# Firebase SERVICE ACCOUNT for push notifications — the JSON itself, or a path
# to it. This is NOT google-services.json: get it from Firebase Console →
# Project Settings → Service accounts → Generate new private key.
# Optional: without it Session Health still detects outages and queues messages;
# only the push tier logs instead of sending.
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Marketplace site. Payment links point at WEB_URL/pay/<token>.
WEB_URL=http://localhost:3001

# Deposits gateway: simulated (dev/test only, refused in production) or jazzcash.
PAYMENT_PROVIDER=simulated
# JazzCash sandbox merchant credentials (merchant portal → Integration).
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk
