{
  "name": "@scalivo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "link-session": "tsx --env-file=.env src/scripts/link-session.ts",
    "evaluate": "tsx --env-file=.env src/scripts/evaluate.ts",
    "evaluate:local": "tsx --env-file=.env --env-file=.env.local src/scripts/evaluate.ts",
    "dev:local": "tsx watch --env-file=.env --env-file=.env.local src/index.ts",
    "seed:local": "tsx --env-file=.env --env-file=.env.local src/scripts/seed.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@scalivo/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "mongoose": "^8.8.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
